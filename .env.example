# =========================================================
# SUPABASE
# =========================================================
# Public — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — server-side only. Never prefix with NEXT_PUBLIC_.
# Used for admin operations, order/payment writes, and stock updates.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =========================================================
# PAYSTACK (Nigerian card payments)
# =========================================================
# SECRET — server-only. Used to initialize and verify transactions.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Not currently used by the app (the redirect/Standard flow only needs the
# secret key above), kept in case an inline checkout widget is added later.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# =========================================================
# WHATSAPP
# =========================================================
# Store's WhatsApp number in international format, no + or spaces
# e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=2348012345678

# =========================================================
# SITE
# =========================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
